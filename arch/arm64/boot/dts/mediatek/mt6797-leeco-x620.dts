// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;
#include "mt6797.dtsi"
#include <dt-bindings/clock/mt6797-clk.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "LeEco X620 (U-Boot relay bring-up)";
	compatible = "leeco,x620", "mediatek,mt6797";
	aliases {
		mmc0 = &msdc0;
		i2c4 = &i2c4;
		ovl0 = &disp_ovl0;
		ovl-2l0 = &disp_ovl0_2l;
		rdma0 = &disp_rdma0;
		dsi0 = &dsi0;
		mutex0 = &disp_mutex;
	};
	cpus {
		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};
			cluster1 {
				core0 { cpu = <&cpu4>; };
				core1 { cpu = <&cpu5>; };
				core2 { cpu = <&cpu6>; };
				core3 { cpu = <&cpu7>; };
			};
		};
	};
	memory@40000000 {
		device_type = "memory";
		/* LK-populated banks from the live stock DT; firmware holes stay excluded. */
		reg = <0 0x40000000 0 0x4e000000>,
		      <0 0x8e600000 0 0x11a00000>,
		      <0 0xa0000000 0 0x12000000>,
		      <0 0xb9000000 0 0x03000000>,
		      <0 0xbcc00000 0 0x002c0000>,
		      <0 0xc0000000 0 0x40000000>;
	};
	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		bootargs = "console=tty0 earlycon=x620ram,mmio32,0x444bf000 keep_bootcon loglevel=8 ignore_loglevel printk.time=1 clk_ignore_unused pd_ignore_unused maxcpus=8 cpuidle.off=1 rdinit=/init panic=0 fbcon=nodefer";
		framebuffer@bd0c0000 {
			compatible = "simple-framebuffer";
			reg = <0 0xbd0c0000 0 0x7f8000>;
			width = <1080>;
			height = <1920>;
			stride = <4352>;
			format = "x8r8g8b8";
		};
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		spm@40000000 { reg = <0 0x40000000 0 0x1000>; no-map; };
		lk-dtb@44000000 { reg = <0 0x44000000 0 0x400000>; no-map; };
		vendor-logs@44400000 { reg = <0 0x44400000 0 0xbf000>; no-map; };
		/* Raw persistent console is read by stock TWRP; not owned by ramoops. */
		relay-console@444bf000 { reg = <0 0x444bf000 0 0x10000>; no-map; };
		vendor-dump@444cf000 { reg = <0 0x444cf000 0 0x31000>; no-map; };
		atf@44600000 { reg = <0 0x44600000 0 0x70000>; no-map; };
		preloader@44800000 { reg = <0 0x44800000 0 0x100000>; no-map; };
		lk@46000000 { reg = <0 0x46000000 0 0x400000>; no-map; };
		framebuffer@bd0c0000 { reg = <0 0xbd0c0000 0 0x1be0000>; no-map; };
		/* Stock /proc/iomem fixes the dynamic SCP/CONSYS/SPM allocations here. */
		scp@8f000000 { reg = <0 0x8f000000 0 0x1000000>; no-map; };
		consys_mem: consys@bcc00000 { reg = <0 0xbcc00000 0 0x200000>; no-map; };
		spm-work@bcea0000 { reg = <0 0xbcea0000 0 0x16000>; no-map; };
	};


	pwrap@1000d000 {
		compatible = "mediatek,mt6797-pwrap";
		reg = <0 0x1000d000 0 0x1000>;
		reg-names = "pwrap";
		interrupts = <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>;
		mediatek,retain-bootloader-state;
		pmic_mt6351: pmic {
			compatible = "mediatek,mt6351";
			regulators {
				vcn18: ldo_vcn18 {
					regulator-name = "vcn18";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};
				vcn28: ldo_vcn28 {
					regulator-name = "vcn28";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};
				vcn33_bt: ldo_vcn33_bt {
					regulator-name = "vcn33_bt";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};
				vcn33_wifi: ldo_vcn33_wifi {
					regulator-name = "vcn33_wifi";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
				};
			};
		};
	};
	consys: consys@18070000 {
		compatible = "mediatek,mt6797-consys";
		reg = <0 0x18070000 0 0x200>, <0 0x10007000 0 0x100>,
		      <0 0x10000000 0 0x2000>, <0 0x10006000 0 0x1000>;
		interrupts = <GIC_SPI 284 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_SPI 285 IRQ_TYPE_LEVEL_LOW>;
		memory-region = <&consys_mem>;
		vcn18-supply = <&vcn18>;
		vcn28-supply = <&vcn28>;
		vcn33_bt-supply = <&vcn33_bt>;
		vcn33_wifi-supply = <&vcn33_wifi>;
		/* Stock WMT_SOC.cfg: gps_lna_enable=0, co_clock_flag=0. */
		mediatek,no-gps-lna;
		clocks = <&infra_clocks CLK_INFRA_BTIF>, <&infra_clocks CLK_INFRA_AP_DMA>;
		clock-names = "btifc", "apdmac";
	};
	btif@1100c000 {
		compatible = "mediatek,mt6797-btif", "mediatek,btif";
		reg = <0 0x1100c000 0 0x1000>;
		interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infra_clocks CLK_INFRA_BTIF>, <&infra_clocks CLK_INFRA_AP_DMA>;
		clock-names = "btifc", "apdmac";
	};
	btif-tx@11000a00 {
		compatible = "mediatek,btif_tx";
		reg = <0 0x11000a00 0 0x80>;
		interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_LOW>;
	};
	btif-rx@11000a80 {
		compatible = "mediatek,btif_rx";
		reg = <0 0x11000a80 0 0x80>;
		interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_LOW>;
	};
	wifi@180f0000 {
		compatible = "mediatek,mt6797-wlan", "mediatek,WIFI";
		reg = <0 0x180f0000 0 0x1100>;
		interrupts = <GIC_SPI 283 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&infra_clocks CLK_INFRA_AP_DMA>;
		clock-names = "wifi-dma";
	};
	lk_vusb: regulator-vusb {
		compatible = "regulator-fixed";
		regulator-name = "lk-retained-vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
	usb_resources: usb-resources@11290000 {
		compatible = "leeco,x620-lk-usb-resources";
		reg = <0 0x11290000 0 0x1000>, <0 0x10001000 0 0x1000>;
		reg-names = "phy", "infracfg";
		#phy-cells = <0>;
		#clock-cells = <1>;
	};
	usb@11271000 {
		compatible = "mediatek,mt6797-mtu3", "mediatek,mtu3";
		/* Linux offsets start at the device block, unlike U-Boot's xHCI base. */
		reg = <0 0x11271000 0 0x3000>, <0 0x11280700 0 0x100>;
		reg-names = "mac", "ippc";
		/* Live vendor DT: device SPI 127, host SPI 126. */
		interrupts = <GIC_SPI 127 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "device";
		clocks = <&usb_resources 1>, <&usb_resources 2>,
			 <&usb_resources 0>, <&usb_resources 0>;
		clock-names = "sys_ck", "ref_ck", "mcu_ck", "dma_ck";
		phys = <&usb_resources>;
		vusb33-supply = <&lk_vusb>;
		dr_mode = "peripheral";
		maximum-speed = "high-speed";
		mediatek,u3p-dis-msk = <1>;
		mediatek,force-vbus;
	};

	infra_clocks: infra-clocks {
		compatible = "mediatek,mt6797-infracfg-retained";
		#clock-cells = <1>;
		mediatek,topckgen = <&topckgen>;
		mediatek,infracfg = <&infrasys>;
		mediatek,apmixedsys = <&apmixedsys>;
	};

	msdc_clocks: msdc0-clocks {
		compatible = "leeco,x620-msdc0-clocks";
		#clock-cells = <1>;
		mediatek,topckgen = <&topckgen>;
		mediatek,infracfg = <&infrasys>;
		mediatek,apmixedsys = <&apmixedsys>;
		mediatek,high-speed;
	};
	msdc_vmmc: regulator-emmc {
		compatible = "regulator-fixed";
		regulator-name = "lk-retained-vemc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
	};
	msdc_vqmmc: regulator-emmc-io {
		compatible = "regulator-fixed";
		regulator-name = "lk-retained-emmc-io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
	msdc0: mmc@11230000 {
		compatible = "mediatek,mt6797-mmc";
		reg = <0 0x11230000 0 0x1000>;
		interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&msdc_clocks 0>, <&msdc_clocks 1>, <&msdc_clocks 2>;
		clock-names = "source", "hclk", "source_cg";
		/* Empty states preserve the working pinmux/drive settings from LK. */
		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		vmmc-supply = <&msdc_vmmc>;
		vqmmc-supply = <&msdc_vqmmc>;
		bus-width = <8>;
		max-frequency = <200000000>;
		cap-mmc-highspeed;
		mmc-hs200-1_8v;
		mmc-hs400-1_8v;
		mediatek,tuning-step = <64>;
		mediatek,latch-ck = <1>;
		/* MT6797 autok uses coarse DS delay 20 and scans the fine delays. */
		mediatek,hs400-ds-dly3 = <20>;
		non-removable;
		no-sd;
		no-sdio;
	};

	display_clock: display-clock {
		compatible = "leeco,x620-display-clock";
		#clock-cells = <0>;
		mediatek,topckgen = <&topckgen>;
		mediatek,apmixedsys = <&apmixedsys>;
	};
	display_larb0: syscon@14020000 {
		compatible = "mediatek,mt6797-smi-larb", "syscon";
		reg = <0 0x14020000 0 0x1000>;
		status = "disabled";
	};
	display_larb5: syscon@14021000 {
		compatible = "mediatek,mt6797-smi-larb", "syscon";
		reg = <0 0x14021000 0 0x1000>;
		status = "disabled";
	};
	mipi_tx0: dsi-phy@10215000 {
		compatible = "mediatek,mt6797-mipi-tx";
		reg = <0 0x10215000 0 0x1000>;
		clocks = <&clk26m>;
		clock-output-names = "mt6797-mipi-tx0";
		#clock-cells = <0>;
		#phy-cells = <0>;
	};
	disp_ovl0: ovl@1400b000 {
		compatible = "mediatek,mt6797-disp-ovl";
		reg = <0 0x1400b000 0 0x1000>;
		interrupts = <GIC_SPI 213 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_OVL0>;
	};
	disp_ovl0_2l: ovl-2l@1400d000 {
		compatible = "mediatek,mt6797-disp-ovl-2l";
		reg = <0 0x1400d000 0 0x1000>;
		interrupts = <GIC_SPI 215 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_OVL0_2L>;
	};
	disp_rdma0: rdma@1400f000 {
		compatible = "mediatek,mt6797-disp-rdma";
		reg = <0 0x1400f000 0 0x1000>;
		interrupts = <GIC_SPI 217 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_RDMA0>;
	};
	disp_color0: color@14013000 {
		compatible = "mediatek,mt6797-disp-color";
		reg = <0 0x14013000 0 0x1000>;
		interrupts = <GIC_SPI 221 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_COLOR>;
	};
	disp_ccorr: ccorr@14014000 {
		compatible = "mediatek,mt6797-disp-ccorr";
		reg = <0 0x14014000 0 0x1000>;
		interrupts = <GIC_SPI 222 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_CCORR>;
	};
	disp_aal0: aal@14015000 {
		compatible = "mediatek,mt6797-disp-aal";
		reg = <0 0x14015000 0 0x1000>;
		interrupts = <GIC_SPI 223 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_AAL>;
	};
	disp_gamma: gamma@14016000 {
		compatible = "mediatek,mt6797-disp-gamma";
		reg = <0 0x14016000 0 0x1000>;
		interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_GAMMA>;
	};
	disp_od0: od@14017000 {
		compatible = "mediatek,mt6797-disp-od";
		reg = <0 0x14017000 0 0x1000>;
		interrupts = <GIC_SPI 225 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_OD>;
	};
	disp_dither0: dither@14018000 {
		compatible = "mediatek,mt6797-disp-dither";
		reg = <0 0x14018000 0 0x1000>;
		interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_DITHER>;
	};
	disp_ufoe: ufoe@14019000 {
		compatible = "mediatek,mt6797-disp-ufoe";
		reg = <0 0x14019000 0 0x1000>;
		interrupts = <GIC_SPI 227 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DISP_UFOE>;
	};
	disp_mutex: mutex@1401f000 {
		compatible = "mediatek,mt6797-disp-mutex";
		reg = <0 0x1401f000 0 0x1000>;
		interrupts = <GIC_SPI 202 IRQ_TYPE_LEVEL_LOW>;
	};
	dsi0: dsi@1401c000 {
		compatible = "mediatek,mt6797-dsi";
		reg = <0 0x1401c000 0 0x1000>;
		interrupts = <GIC_SPI 229 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&mmsys CLK_MM_DSI0_MM_CLOCK>,
			 <&mmsys CLK_MM_DSI0_INTERFACE_CLOCK>, <&mipi_tx0>;
		clock-names = "engine", "digital", "hs";
		phys = <&mipi_tx0>;
		phy-names = "dphy";
		#address-cells = <1>;
		#size-cells = <0>;
		port {
			dsi0_out: endpoint { remote-endpoint = <&panel_in>; };
		};
		panel@0 {
			compatible = "leeco,x620-378c81";
			reg = <0>;
			mediatek,mmsys = <&mmsys>;
			port {
				panel_in: endpoint { remote-endpoint = <&dsi0_out>; };
			};
		};
	};
};

/* Retain firmware clocks except the isolated MSDC0 clock provider above. */
&topckgen {
	compatible = "mediatek,mt6797-topckgen", "syscon";
	status = "disabled";
};
&infrasys { status = "disabled"; };
&apmixedsys {
	compatible = "mediatek,mt6797-apmixedsys", "syscon";
	status = "disabled";
};
&mmsys {
	status = "okay";
	clocks = <&display_clock>;
	clock-names = "mm";
	mediatek,larb0 = <&display_larb0>;
	mediatek,larb5 = <&display_larb5>;
};
&imgsys { status = "disabled"; };
&vdecsys { status = "disabled"; };
&vencsys { status = "disabled"; };
&scpsys { status = "disabled"; };
&pio {
	reg = <0 0x10005000 0 0x1000>,
	      <0 0x10002000 0 0x400>,
	      <0 0x10002400 0 0x400>,
	      <0 0x10002800 0 0x400>,
	      <0 0x10002c00 0 0x400>,
	      <0 0x1000b000 0 0x1000>;
	reg-names = "gpio", "iocfgl", "iocfgb", "iocfgr", "iocfgt", "eint";
	interrupts = <GIC_SPI 170 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-controller;
	#interrupt-cells = <2>;
	status = "okay";

	touch_irq: touch-irq {
		pins {
			pinmux = <MT6797_GPIO68__FUNC_EINT7>;
			input-enable;
			bias-pull-down;
		};
	};

	touch_reset: touch-reset {
		pins {
			pinmux = <MT6797_GPIO57__FUNC_GPIO57>;
			output-high;
		};
	};
};

&i2c4 {
	compatible = "mediatek,mt6797-i2c";
	clocks = <&infra_clocks CLK_INFRA_I2C4>, <&infra_clocks CLK_INFRA_AP_DMA>;
	clock-names = "main", "dma";
	clock-frequency = <400000>;
	clock-div = <10>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins_a>;
	status = "okay";

	touchscreen@4b {
		compatible = "syna,rmi4-i2c";
		reg = <0x4b>;
		interrupt-parent = <&pio>;
		/* Stock EIC maps GPIO68 to EINT7, with falling-edge attention. */
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pio 57 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_irq>, <&touch_reset>;
		/* Active stock Synaptics v61: 200ms ready, 20ms reset pulse. */
		syna,startup-delay-ms = <200>;
		syna,reset-delay-ms = <200>;
		#address-cells = <1>;
		#size-cells = <0>;

		rmi4-f01@1 {
			reg = <1>;
		};

		rmi4-f12@12 {
			reg = <0x12>;
			syna,sensor-type = <1>;
		};
	};
};

/* Hide A72 CPUs while debugging the CPU8 startup hang. */
/delete-node/ &cpu8;
/delete-node/ &cpu9;
